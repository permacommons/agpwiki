<!doctype html>
<html lang="{{locale}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="{{{assets.siteCss}}}" />
    {{!-- Progressive enhancement hooks: .js-enabled hides no-js-only fallbacks, noscript hides requires-js controls. --}}
    <script>document.documentElement.classList.add('js-enabled');</script>
    <noscript><style>.requires-js { display: none !important; }</style></noscript>
  </head>
  <body
    {{#if wikiLinkPreviewConfig}}
    data-wiki-link-preview-endpoint="{{wikiLinkPreviewConfig.endpoint}}"
    data-wiki-link-preview-intro-html="{{wikiLinkPreviewConfig.introHtml}}"
    data-wiki-link-preview-missing-loading="{{wikiLinkPreviewConfig.missingLoading}}"
    data-wiki-link-preview-token="{{wikiLinkPreviewConfig.token}}"
    data-wiki-link-preview-wikipedia-attribution-html="{{wikiLinkPreviewConfig.wikipediaAttributionHtml}}"
    data-wiki-link-preview-wikipedia-heading="{{wikiLinkPreviewConfig.wikipediaHeading}}"
    data-wiki-link-preview-wikipedia-link-label="{{wikiLinkPreviewConfig.wikipediaLinkLabel}}"
    {{/if}}
  >
    {{> header}}
    {{{topHtml}}}
    <div class="page-layout{{#unless sidebarHtml}} single{{/unless}}">
      <main class="article">
        {{{labelHtml}}}
        <h1>{{title}}</h1>
        {{{bodyHtml}}}
      </main>
      {{#if sidebarHtml}}
      <aside class="sidebar">
        {{{sidebarHtml}}}
      </aside>
      {{/if}}
    </div>
    {{> footer}}
    <script src="{{{assets.forumJs}}}" defer></script>
    <script src="{{{assets.markdownPreviewJs}}}" defer></script>
    <script src="{{{assets.searchJs}}}" defer></script>
    <script src="{{{assets.metaTooltipsJs}}}" defer></script>
    <script src="{{{assets.wikiLinkPreviewsJs}}}" defer></script>
    <script src="{{{assets.tableScrollHintsJs}}}" defer></script>
    <script src="{{{assets.tocJs}}}" defer></script>
  </body>
</html>
