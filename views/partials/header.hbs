<header class="site-header">
  <a class="home-link" href="/meta/welcome">{{__ "nav.home"}}</a>
  <nav class="nav-menu" aria-label="{{__ "nav.menu"}}">
    <input class="nav-toggle-checkbox" type="checkbox" id="nav-toggle" />
    <label class="nav-toggle" for="nav-toggle" aria-hidden="true"></label>
    <div class="nav-menu-content">
      <a class="nav-link" href="/blog">{{__ "nav.blog"}}</a>
      <a class="nav-link" href="/tool/recent-changes">{{__ "nav.recentChanges"}}</a>
      <a class="nav-link" href="/meta/help">{{__ "nav.help"}}</a>
      {{#if signedIn}}
      <details class="user-menu">
        <summary class="user-menu-summary">
          <span class="user-menu-summary-main">
            <span class="user-menu-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M463 448.2C440.9 409.8 399.4 384 352 384L288 384C240.6 384 199.1 409.8 177 448.2C212.2 487.4 263.2 512 320 512C376.8 512 427.8 487.3 463 448.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 336C359.8 336 392 303.8 392 264C392 224.2 359.8 192 320 192C280.2 192 248 224.2 248 264C248 303.8 280.2 336 320 336z"/></svg>
            </span>
            {{#if currentUserName}}
            <span class="user-menu-name">{{currentUserName}}</span>
            {{/if}}
          </span>
        </summary>
        <div class="user-menu-panel">
          {{#if currentUserName}}
          <div class="user-menu-heading">{{currentUserName}}</div>
          {{/if}}
          <a class="user-menu-link" href="/tool/tokens">{{__ "auth.tokens.title"}}</a>
          <form class="user-menu-form" method="post" action="/tool/logout">
            <button class="user-menu-action" type="submit">{{__ "nav.signOut"}}</button>
          </form>
        </div>
      </details>
      {{else}}
      <a class="nav-link" href="/tool/login?redirect={{urlencode currentPath}}">{{__ "auth.login.title"}}</a>
      {{/if}}
      <form class="lang-form" method="post" action="/set-locale">
        <select class="lang-selector" name="locale" onchange="this.form.submit()">
          {{#each languageOptions}}
          <option value="{{this.code}}" {{#if (eq this.code ../locale)}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <noscript><button type="submit">{{__ "language.selector"}}</button></noscript>
      </form>
    </div>
  </nav>
  <form class="search-form" action="/search" method="get">
    <input class="search-input" type="search" name="q" placeholder="{{__ "search.placeholder"}}" autocomplete="off" />
    <ul class="search-suggestions" role="listbox"></ul>
  </form>
</header>
