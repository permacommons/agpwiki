<header class="site-header">
  <a class="home-link" href="/meta/welcome">{{__ "nav.home"}}</a>
  <nav class="nav-menu" aria-label="{{__ "nav.menu"}}">
    <input class="nav-toggle-checkbox" type="checkbox" id="nav-toggle" />
    <label class="nav-toggle" for="nav-toggle" aria-hidden="true"></label>
    <div class="nav-menu-content">
      <a class="nav-link" href="/blog">{{__ "nav.blog"}}</a>
      <a class="nav-link" href="/tool/forum">{{__ "nav.forum"}}</a>
      <a class="nav-link" href="/tool/recent-changes">{{__ "nav.recentChanges"}}</a>
      <a class="nav-link" href="/meta/help">{{__ "nav.help"}}</a>
      {{#if signedIn}}
      <details class="user-menu">
        <summary class="user-menu-summary">
          <span class="user-menu-summary-main">
            <span class="user-menu-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M463 448.2C440.9 409.8 399.4 384 352 384L288 384C240.6 384 199.1 409.8 177 448.2C212.2 487.4 263.2 512 320 512C376.8 512 427.8 487.3 463 448.2zM64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576C178.6 576 64 461.4 64 320zM320 336C359.8 336 392 303.8 392 264C392 224.2 359.8 192 320 192C280.2 192 248 224.2 248 264C248 303.8 280.2 336 320 336z"/></svg>
            </span>
            {{#if currentUserName}}
            <span class="user-menu-name">{{currentUserName}}</span>
            {{/if}}
          </span>
        </summary>
        <div class="user-menu-panel">
          {{#if isSiteAdmin}}
          <a class="user-menu-link" href="/tool/review-accounts">{{__ "nav.reviewAccounts"}}</a>
          {{/if}}
          <a class="user-menu-link" href="/tool/tokens">{{__ "auth.tokens.title"}}</a>
          <form class="user-menu-form" method="post" action="/tool/logout">
            <button class="user-menu-action" type="submit">{{__ "nav.signOut"}}</button>
          </form>
        </div>
      </details>
      {{else}}
      <a class="nav-link" href="/tool/login?redirect={{urlencode currentPath}}">{{__ "auth.login.title"}}</a>
      {{/if}}
      <details class="lang-menu">
        <summary
          class="lang-menu-summary"
          aria-label="{{__ "language.selector"}}"
          title="{{findLanguageLabel languageOptions locale}}"
        >
          <span class="lang-menu-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path d="M415.9 344L225 344C227.9 408.5 242.2 467.9 262.5 511.4C273.9 535.9 286.2 553.2 297.6 563.8C308.8 574.3 316.5 576 320.5 576C324.5 576 332.2 574.3 343.4 563.8C354.8 553.2 367.1 535.8 378.5 511.4C398.8 467.9 413.1 408.5 416 344zM224.9 296L415.8 296C413 231.5 398.7 172.1 378.4 128.6C367 104.2 354.7 86.8 343.3 76.2C332.1 65.7 324.4 64 320.4 64C316.4 64 308.7 65.7 297.5 76.2C286.1 86.8 273.8 104.2 262.4 128.6C242.1 172.1 227.8 231.5 224.9 296zM176.9 296C180.4 210.4 202.5 130.9 234.8 78.7C142.7 111.3 74.9 195.2 65.5 296L176.9 296zM65.5 344C74.9 444.8 142.7 528.7 234.8 561.3C202.5 509.1 180.4 429.6 176.9 344L65.5 344zM463.9 344C460.4 429.6 438.3 509.1 406 561.3C498.1 528.6 565.9 444.8 575.3 344L463.9 344zM575.3 296C565.9 195.2 498.1 111.3 406 78.7C438.3 130.9 460.4 210.4 463.9 296L575.3 296z"/></svg>
          </span>
          <span class="lang-menu-prefix">{{__ "language.selector"}}</span>
          <span class="lang-menu-label">{{locale}}</span>
        </summary>
        <div class="lang-menu-panel">
          {{#each languageOptions}}
          <form class="lang-menu-form" method="post" action="/set-locale">
            <button
              class="lang-menu-option{{#if (eq this.code ../locale)}} lang-menu-option--active{{/if}}"
              type="submit"
              name="locale"
              value="{{this.code}}"
            >{{this.label}}</button>
          </form>
          {{/each}}
        </div>
      </details>
    </div>
  </nav>
  <form class="search-form" action="/search" method="get">
    <input class="search-input" type="search" name="q" placeholder="{{__ "search.placeholder"}}" autocomplete="off" />
    <ul class="search-suggestions" role="listbox"></ul>
  </form>
</header>
