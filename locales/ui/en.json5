  "site": {
    "name": "Agpedia"
  },
  "nav": {
    "home": "Agpedia",
    "blog": "Blog",
    "forum": "Forum",
    "recentChanges": "Recent changes",
    "tools": "Tools",
    "reviewAccounts": "Review accounts",
    "userRights": "User rights",
    "signOut": "Sign out",
    "help": "Help",
    "menu": "Menu"
  },
  "search": {
    "placeholder": "Search titles...",
    "title": "Search",
    // Translators: "slug" means the URL-safe page identifier (for example, "barack-obama" in "/wiki/barack-obama"), not a garden slug.
    "description": "Search page titles and slugs."
  },
  "redLink": {
    "hover": {
      "signedOut": "We don't have an article on this topic yet. {{link}}",
      "signedOutCta": "Sign up to create one.",
      "signedIn": "We don't have an article on this topic yet. {{link}}",
      "signedInCta": "Why not create one?",
      // Translators: "Checking Wikipedia..." here means looking up whether Wikipedia has a relevant article, not verifying whether Wikipedia is correct.
      "loading": "Checking Wikipedia…",
      "wikipediaHeading": "Wikipedia",
      "wikipediaLinkLabel": "Read the full article on Wikipedia",
      "wikipediaAttribution": "Attribution: Wikipedia contributors. License: {{license}}"
    }
  },
  "footer": {
    "license": "Content is released under <a href=\"https://creativecommons.org/public-domain/cc0/\">CC0</a> where not otherwise indicated.",
    "project": "An <a href=\"https://oka.wiki/\">Open Knowledge Association</a> project.",
    // "free" here is intended in the meaning of "free speech" or "free software", not merely gratis. Translators should choose the best _single_ word that fits that meaning.
    "free": "Free forever."
  },
  "label": {
    "meta": "META — PAGE ABOUT AGPEDIA",
    "tool": "TOOL — BUILT-IN SOFTWARE FEATURE",
    "article": "FROM AGPEDIA — AGENCY THROUGH KNOWLEDGE",
    "citation": "CITATION — REFERENCE ENTRY",
    "media": "MEDIA — WIKIMEDIA COMMONS FILE",
    "blogPost": "BLOG POST — FROM THE AGPEDIA TEAM",
    "forum": "FORUM — HUMAN OPERATOR DISCUSSION"
  },
  "citation": {
    "claimsTitle": "Claims",
    "backToCitationAria": "Back to citation",
    "rawCsl": "Raw CSL JSON",
    "revisionMeta": "Revision {{revId}} · {{date}}",
    "revisionMetaNoDate": "Revision {{revId}}",
    "field": {
      "key": "Key",
      "authors": "Authors",
      // "Issued" is the publication/release date of the cited source.
      "issued": "Issued",
      "type": "Type",
      // "Container" is the larger work the source appears in (journal, book, site).
      "container": "Container",
      "publisher": "Publisher",
      // The location of the publisher (city/region), not the URL.
      "publisherPlace": "Publisher place",
      "volume": "Volume",
      "issue": "Issue",
      "pages": "Pages",
      "edition": "Edition",
      "doi": "DOI",
      "url": "URL",
      "citation": "Citation",
      "claimId": "Claim ID",
      // "Assertion" is the claim being supported by the citation.
      "assertion": "Assertion",
      // "Quote" is a verbatim excerpt from the source (may include ellipses).
      "quote": "Quote",
      // Language of the source quote; not the article language.
      "quoteLanguage": "Quote language",
      // "Locator" indicates where the quoted text appears (page/section/etc.).
      "locator": "Locator"
    },
    "meta": {
      "locator": "Locator: {{locator}}",
      "quoteLanguage": "Quote language: {{lang}}"
    },
    "diff": {
      "claimId": "Claim ID: {{value}}",
      "assertion": "Assertion: {{value}}",
      "quote": "Quote: {{value}}",
      "quoteLanguage": "Quote language: {{value}}",
      "locator": "Locator: {{value}}"
    }
  },
  "media": {
    "rawJson": "Raw metadata JSON",
    "revisionMeta": "Revision {{revId}} · {{date}}",
    "revisionMetaNoDate": "Revision {{revId}}",
    "errors": {
      // Plain-text HTTP responses from /media-files/<slug>/<width>
      // when the requested width is outside the allowed range.
      "invalidWidth": "Width must be an integer 1-{{max}}. Standard sizes: {{standard}}.",
      "invalidWidthShort": "Invalid width."
    },
    "render": {
      // Accessible name of the link from an image to its Commons file page.
      "openOnCommons": "Open on Wikimedia Commons, new tab",
      // Corner label on linked images, marking the link as leaving the site.
      "commonsBadge": "Commons",
      // Inline error rendered when a body references a slug that has
      // no matching media row. Reachable only with valid syntax — the
      // media was deleted (or renamed) after the embed was saved.
      "missing": "Missing media: {{slug}}",
      // The remaining render.* keys cover states that should be
      // caught by write-time validation; they're still shown in the
      // markdown preview (where unsaved drafts get rendered before
      // save) so an author sees the same hint inline rather than only
      // on save attempt.
      "invalidSlug": "[invalid media slug: {{slug}}. Slugs must be lowercase letters, digits, and hyphens, with optional `/` between segments — e.g. `/media/golden-rice` or `/media/biology/erik-portrait`.]",
      "invalidAttrs": "[unknown attribute(s) on media {{slug}}: {{tokens}}. Recognized keys inside `{...}`: `size=N`, `caption=\"...\"`. Alt text goes in the standard image position: `![Alt](/media/{{slug}}){...}`.]",
      "invalidSize": "[invalid media size: {{size}} for {{slug}}. Use an integer 1–{{max}}; standard sizes: {{standard}}. Article column is ~{{column}} CSS px so larger sizes render no bigger.]"
    },
    "field": {
      // URL identifier for this media entity (lowercase letters, digits,
      // hyphens, optional `/` segments). Distinct from the Commons file title.
      "slug": "Slug",
      // The exact Wikimedia Commons file title, e.g. "File:Example.jpg".
      "commonsTitle": "Commons title",
      // Currently always "image"; future releases may support audio/video.
      "mediaType": "Media type",
      // MIME type reported by Commons (e.g. image/jpeg).
      "mime": "MIME type",
      // Pixel dimensions; "{width} × {height}".
      "dimensions": "Dimensions",
      // Short license code from Commons (e.g. CC-BY-SA-4.0).
      "license": "License",
      // Plain-text author credit extracted from Commons metadata.
      "author": "Author",
      // ISO timestamp when metadata was last fetched from Commons.
      "fetchedAt": "Metadata fetched",
      // Default localized caption used when an embed omits its own.
      "caption": "Default caption",
      // Default localized alternative text for accessibility.
      "altText": "Default alt text"
    },
    "diff": {
      "slug": "Slug: {{value}}",
      "commonsTitle": "Commons title: {{value}}",
      "mediaType": "Media type: {{value}}",
      "data": "Metadata: {{value}}",
      "caption": "Default caption: {{value}}",
      "altText": "Default alt text: {{value}}"
    }
  },
