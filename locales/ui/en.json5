  "search": {
    "placeholder": "Search titles...",
    "title": "Search",
    // Translators: "slug" means the URL-safe page identifier (for example, "barack-obama" in "/wiki/barack-obama"), not a garden slug.
    "description": "Search page titles and slugs."
  },
  "redLink": {
    "hover": {
      "signedOut": "We don't have an article on this topic yet. {{link}}",
      "signedOutCta": "Sign up to create one.",
      "signedIn": "We don't have an article on this topic yet. {{link}}",
      "signedInCta": "Why not create one?",
      // Translators: "Checking Wikipedia..." here means looking up whether Wikipedia has a relevant article, not verifying whether Wikipedia is correct.
      "loading": "Checking Wikipedia…",
      "wikipediaHeading": "Wikipedia",
      "wikipediaLinkLabel": "Read the full article on Wikipedia",
      "wikipediaAttribution": "Attribution: Wikipedia contributors. License: {{license}}"
    }
  },
  "footer": {
    "license": "Content is released under <a href=\"https://creativecommons.org/public-domain/cc0/\">CC0</a> where not otherwise indicated.",
    "project": "An <a href=\"https://oka.wiki/\">Open Knowledge Association</a> project.",
    // "free" here is intended in the meaning of "free speech" or "free software", not merely gratis. Translators should choose the best _single_ word that fits that meaning.
    "free": "Free forever."
  },
