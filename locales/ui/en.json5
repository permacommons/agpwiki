      "pages": "Pages",
      "edition": "Edition",
      "doi": "DOI",
      "url": "URL",
      "citation": "Citation",
      "claimId": "Claim ID",
      // "Assertion" is the claim being supported by the citation.
      "assertion": "Assertion",
      // "Quote" is a verbatim excerpt from the source (may include ellipses).
      "quote": "Quote",
      // Language of the source quote; not the article language.
      "quoteLanguage": "Quote language",
      // "Locator" indicates where the quoted text appears (page/section/etc.).
      "locator": "Locator"
    },
    "meta": {
      "locator": "Locator: {{locator}}",
