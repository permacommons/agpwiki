{
  server: {
    port: 3000,
    trustProxy: false,
  },
  postgres: {
    host: 'localhost',
    port: 5432,
    database: 'agpwiki_test',
    user: 'agpwiki_user',
    password: 'agpwiki_password',
    max: 10,
    idleTimeoutMillis: 30000,
    connectionTimeoutMillis: 2000,
  },
  mcp: {
    skipPolicyCheck: false,
  },
  oauth: {
    authorizationCodeTtlSeconds: 600,
    accessTokenTtlSeconds: 28800,
    refreshTokenTtlSeconds: 1209600,
    allowDynamicClientRegistration: true,
    defaultScopes: ['mcp.read', 'mcp.write'],
  },
  site: {
    baseUrl: 'http://127.0.0.1:3000',
  },
  email: {
    enabled: false,
    provider: null,
  },
  rateLimits: {
    signup: {
      maxAttempts: 5,
      windowMs: 900000,
    },
    login: {
      maxAttempts: 10,
      windowMs: 900000,
    },
    resendConfirmationEmail: {
      maxAttempts: 5,
      windowMs: 900000,
    },
  },
}
